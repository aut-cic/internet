// https://webpack.js.org/guides/typescript/
{
  "compilerOptions": {
    "paths": {
      "bootstrap/dist/js/bootstrap.min.js": ["./node_modules/@types/bootstrap"]
    },
    "rootDir": "./src",
    "outDir": "./dist/",
    "strict": true,
    "noImplicitAny": true,
    "module": "esnext",
    "target": "es2020",
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*"]
}
